# Jest / e2e instance (NODE_ENV=test always resolves here).
NODE_ENV=test
PORT=8080
LOG_PRETTY=false
LOG_HTTP_BODIES=false
SWAGGER_ENABLED=false
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestjs_starter_test
JWT_SECRET=test-secret-not-for-production
